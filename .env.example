# Copy to .env and fill in. With NO Azure keys the app runs in offline/mock mode
# (live SEC data + deterministic stub LLM/DI/search). Add keys to light up Azure.

# --- Server ---------------------------------------------------------
HOST=127.0.0.1
PORT=8001
DEBUG=false
LOG_LEVEL=info

# --- SEC EDGAR (required by their fair-access policy; no key needed) -
# Use a real contact email.
SEC_USER_AGENT=CreditMemo Research your-email@example.com

# --- Human-in-the-loop ----------------------------------------------
SKIP_HITL=false
HITL_TIMEOUT_SECONDS=3600

# --- Force mock even if keys exist (dev) ----------------------------
# FORCE_MOCK_MODE=true

# --- Azure OpenAI (enables real LLM) --------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- Azure Document Intelligence ------------------------------------
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY=

# --- Azure AI Search -------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=credit-memo-chunks

# --- Azure SQL (KPI base metrics) -----------------------------------
# Provide either a full connection string OR server+database (AAD token auth).
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_CONN_STRING=

# --- Azure Blob (optional storage backend) --------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=raw-documents

# --- Local cache directory ------------------------------------------
DATA_DIR=data
